// Copy this file to db.js and update with your database configuration
import { Sequelize } from 'sequelize';

const sequelize = new Sequelize('fastfood', 'root', 'your_password_here', {
  host: '127.0.0.1',
  port: 3306,  // or 3307 for Docker MySQL
  dialect: 'mysql',
  logging: false,
  pool: {
    max: 5,
    min: 0,
    acquire: 30000,
    idle: 10000,
  },
});

export default sequelize;
